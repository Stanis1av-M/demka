<Page x:Class="demka.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Каталог товаров" FontSize="22"
                   FontWeight="Bold" Margin="5"/>

        <!-- Поиск, сортировка, фильтр (только менеджер и администратор) -->
        <StackPanel x:Name="filterPanel" Grid.Row="1" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtSearch" Width="220" Margin="5" MaxLength="100"
                     TextChanged="txtSearch_TextChanged"
                     ToolTip="Поиск по наименованию, описанию, характеристикам, производителю"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="cmbSort" Width="190" Margin="5"
                      SelectionChanged="cmbSort_SelectionChanged"/>

            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="cmbFilter" Width="180" Margin="5"
                      SelectionChanged="cmbFilter_SelectionChanged_1"/>

            <TextBlock x:Name="txtCount" VerticalAlignment="Center" Margin="10,5"/>
        </StackPanel>

        <ListView x:Name="listProduct" Grid.Row="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" BorderThickness="1" CornerRadius="4"
                            BorderBrush="#2F5DA8" Background="{Binding RowColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            
                            <Image Grid.Column="0" Source="{Binding ImagePath}"
                                   Width="100" Height="100" Stretch="Uniform"/>

                            
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding Categories.category, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Характеристики: "/>
                                    <Run Text="{Binding structure, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Producer.producer, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Поставщик (склад): "/>
                                    <Run Text="{Binding StockItems.Manufacturers.manufacturer, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Объём памяти: "/>
                                    <Run Text="{Binding StockItems.Sizes.size, Mode=OneWay}"/>
                                    <Run Text=" ГБ"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                    <Run Text=" шт."/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Цена -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                                       Text="{Binding price, StringFormat={}{0:N2} ₽}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="btnDelete" Content="Удалить товар" Width="150" Margin="5"
                    Background="#FF8080" Click="btnDelete_Click"/>
            <Button x:Name="btnOrders" Content="Заказы" Width="150" Margin="5"
                    Click="btnOrders_Click"/>
            <Button x:Name="btnExit" Content="Выход" Width="150" Margin="5"
                    Background="#AAAAAA" Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Page>

