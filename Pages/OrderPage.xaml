<Page x:Class="demka.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список заказов" FontSize="22"
                   FontWeight="Bold" Margin="5"/>



        <ListView x:Name="listOrders" Grid.Row="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" BorderBrush="#2F5DA8"
                            BorderThickness="1" Background="#E3EDFB" CornerRadius="4">
                        <StackPanel>
                           
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="14">
                                    <Run Text="Заказ №"/>
                                    <Run Text="{Binding id, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Column="1">
                                    <Run Text="Клиент: "/>
                                    <Run Text="{Binding Users.FIO, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding Users.login, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                    <Run Text="Дата: "/>
                                    <Run Text="{Binding orderDate, Mode=OneWay, StringFormat=dd.MM.yyyy}"/>
                                </TextBlock>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding OrderItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="10,1" TextWrapping="Wrap">
                                            <Run Text="• "/>
                                            <Run Text="{Binding StockItems.nameProduct, Mode=OneWay}"/>
                                            <Run Text=", "/>
                                            <Run Text="{Binding StockItems.Sizes.size, Mode=OneWay}"/>
                                            <Run Text=" ГБ ("/>
                                            <Run Text="{Binding StockItems.Manufacturers.manufacturer, Mode=OneWay}"/>
                                            <Run Text=") — "/>
                                            <Run Text="{Binding quantity, Mode=OneWay}"/>
                                            <Run Text=" шт. × "/>
                                            <Run Text="{Binding price, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                                            <Run Text=" = "/>
                                            <Run Text="{Binding Sum, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Run Text="Позиций: "/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                <Run Text=" шт.   Итого: "/>
                                <Run Text="{Binding TotalSum, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>